#!/bin/bash
# prune-cron.sh — hourly cron that bulk-forgets short-term radio memory
# from the HRM. Without this the radio's `kannaka hear` calls accumulate
# 100s of `audio:/home/opc/kannaka-radio/chunks/voice/dj_*.mp3` entries
# per day; on the 5.6 GB Oracle ARM box this drives the HRM toward OOM
# (see feedback memory: kannaka-export-json-coalescing).
#
# Strategy: brief service-cycle (~5 s outage on radio), then `kannaka
# prune-prefix` against the file paths we know carry no semantic content.
# The .hrm file is held open with shared reads by several processes, so
# stopping kannaka-memory + kannaka-radio first avoids torn-write races.
#
# Bridge measure — the long-term plan is to have Kannaktopus manage
# short-term/long-term memory triage. Until then, this keeps the box
# alive.
#
# Vendored as `.example` so a `git stash -u` on Oracle can't sweep it
# (we got bitten by that on run-swarm.sh — see feedback memory:
# oracle-deploy-git-stash-u). Deploy by copying to prune-cron.sh and
# `chmod +x`.
#
# Cron line (in `crontab -e`):
#   17 * * * * /home/opc/kannaka-radio/prune-cron.sh >> /tmp/prune-cron.log 2>&1
#
# Runs at :17 past every hour to stay clear of the :00 dream cron and
# the */5 cache-observe sweeps.

set -u

KANNAKA="/home/opc/kannaka-memory/target/release/kannaka"
LOCK="/tmp/kannaka-prune.lock"
LOG_TAG="[prune-cron $(date -u +%FT%TZ)]"

# Single-instance guard.
if ! mkdir "$LOCK" 2>/dev/null; then
    echo "$LOG_TAG already running, skipping"
    exit 0
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT

if [ ! -x "$KANNAKA" ]; then
    echo "$LOG_TAG kannaka binary missing at $KANNAKA"
    exit 2
fi


# ── disk-side cleanup (runs every hour, independent of HRM prune-prefix) ──
# Voice-DJ TTS chunks accumulate forever — every talk segment leaves a
# dj_<ts>.mp3 in chunks/voice/. After ~3 months we hit 1.5 GB and tripped
# the 100% root-disk incident on 2026-05-19. Voice intros are never replayed.
VOICE_DIR="/home/opc/kannaka-radio/chunks/voice"
if [ -d "$VOICE_DIR" ]; then
    VOICE_BEFORE=$(find "$VOICE_DIR" -name "dj_*.mp3" -mtime +7 2>/dev/null | wc -l)
    if [ "$VOICE_BEFORE" -gt 0 ]; then
        find "$VOICE_DIR" -name "dj_*.mp3" -mtime +7 -delete 2>/dev/null
        echo "$LOG_TAG voice-chunks pruned: $VOICE_BEFORE files >7d old"
    fi
fi
# Ghost Recorder WAV chunks — one-shot, never replayed past the source minute.
WAV_DIR="/home/opc/kannaka-radio/chunks"
if [ -d "$WAV_DIR" ]; then
    WAV_BEFORE=$(find "$WAV_DIR" -maxdepth 1 -name "chunk_*.wav" -mtime +1 2>/dev/null | wc -l)
    if [ "$WAV_BEFORE" -gt 0 ]; then
        find "$WAV_DIR" -maxdepth 1 -name "chunk_*.wav" -mtime +1 -delete 2>/dev/null
        echo "$LOG_TAG wav-chunks pruned: $WAV_BEFORE files >1d old"
    fi
fi
# Stale HRM backups — pre-prune / pre-merge / .bak* / .corrupt-bak-* sidecars
# from past manual rescues. They were >30d unused at the 2026-05-19
# incident (e.g. .pre-prune at 87 MB each, dated May 3). Keep the newest
# kannaka.hrm.v2-backup.* as the floor-level safety net.
HRM_DIR="/home/opc/.kannaka"
if [ -d "$HRM_DIR" ]; then
    HRM_BEFORE=$(find "$HRM_DIR" -maxdepth 1 -type f \
        \( -name "kannaka.hrm.bak-*" -o -name "kannaka.hrm.pre-*" \
           -o -name "kannaka.hrm.merged" -o -name "kannaka.hrm.corrupt-bak-*" \) \
        -mtime +14 2>/dev/null | wc -l)
    if [ "$HRM_BEFORE" -gt 0 ]; then
        find "$HRM_DIR" -maxdepth 1 -type f \
            \( -name "kannaka.hrm.bak-*" -o -name "kannaka.hrm.pre-*" \
               -o -name "kannaka.hrm.merged" -o -name "kannaka.hrm.corrupt-bak-*" \) \
            -mtime +14 -delete 2>/dev/null
        echo "$LOG_TAG stale hrm-backups pruned: $HRM_BEFORE files >14d old"
    fi
fi

# Dry-run first so we always log how many we matched (cheap — 2-3 s).
DRY_OUT=$("$KANNAKA" prune-prefix \
    'audio:/home/opc/kannaka-radio/chunks/voice/' \
    'audio:/home/opc/kannaka-radio/music/' \
    'audio:C:\Users\nickf\Source\kannaka-radio' \
    --dry-run 2>&1 | tail -2)
MATCHES=$(echo "$DRY_OUT" | grep -oE '[0-9]+ match' | head -1 | grep -oE '[0-9]+')
MATCHES=${MATCHES:-0}
echo "$LOG_TAG dry-run says $MATCHES match(es)"

# Skip the service cycle if there's nothing to prune.
if [ "$MATCHES" -lt 200 ]; then
    echo "$LOG_TAG below threshold, no action"
    exit 0
fi

echo "$LOG_TAG cycling HRM daemons for prune (radio stays up — #34)"
# Stop ONLY the long-running HRM writers. Radio interacts with the HRM
# via short-lived `kannaka hear` subprocesses, not a held file handle, so
# keeping it up just makes the next `hear` call queue briefly during the
# prune-prefix lock instead of dropping the stream for 5–10 seconds.
DAEMONS="kannaka-memory kannaka-substrate kannaka-attention kannaka-swarm-serve"
sudo systemctl stop $DAEMONS
# Straggler readers/writers — TERM first, then escalate to KILL after 3s
# (previous unconditional `kill -9` showed up as `Failed with result
# 'signal'` in journal every cycle, masking real failures).
STRAGGLERS=$(pgrep -f 'kannaka (status|swarm|hear|recall|observe|export)' 2>/dev/null || true)
if [ -n "$STRAGGLERS" ]; then
    for pid in $STRAGGLERS; do sudo kill -TERM "$pid" 2>/dev/null || true; done
    sleep 3
    for pid in $STRAGGLERS; do sudo kill -9 "$pid" 2>/dev/null || true; done
fi
sleep 1

OUT=$("$KANNAKA" prune-prefix \
    'audio:/home/opc/kannaka-radio/chunks/voice/' \
    'audio:/home/opc/kannaka-radio/music/' \
    'audio:C:\Users\nickf\Source\kannaka-radio' \
    2>&1 | tail -3)
echo "$LOG_TAG $OUT"

sudo systemctl start $DAEMONS
echo "$LOG_TAG daemons restarted (radio was never stopped)"

# Force the observatory to drop its stale sidecar so the next /api/hrm/observe
# rebuilds against the slimmer HRM.
rm -f /home/opc/.kannaka/observe-cache.json /home/opc/.kannaka/export-cache.json
echo "$LOG_TAG observatory caches invalidated"
